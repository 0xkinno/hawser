#!/usr/bin/env bash
# Remove AI attribution trailers from every commit message.
msg_file="$1"
sed -i.bak -E '/^[[:space:]]*(Co-Authored-By|Co-authored-by):.*([Cc]laude|[Aa]nthropic)/d; /^[[:space:]]*Claude-Session:/d; /[Gg]enerated with.*[Cc]laude/d; /noreply@anthropic\.com/d' "$msg_file"
rm -f "$msg_file.bak"
