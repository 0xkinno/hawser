#!/usr/bin/env bash
# Remove AI attribution trailers from every commit message.
# Strips Claude/Anthropic co-author lines, Claude-Session lines and "Generated with ... Claude" lines,
# case-insensitively. Unrelated co-author lines are left alone.
f="$1"
sed -i.bak -E '/^[[:space:]]*(Co-authored-by:.*(Claude|Anthropic).*|Claude-Session:.*|.*Generated with.*Claude.*|.*noreply@anthropic\.com.*)$/Id' "$f" && rm -f "$f.bak"
# collapse trailing blank lines
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$f"
